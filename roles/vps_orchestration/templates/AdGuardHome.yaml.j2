http:
  address: 0.0.0.0:3000
users:
  - name: admin
    password: {{ vault_adguard_password_hash }}
dns:
  bind_hosts:
    - 0.0.0.0
  port: 53
  upstream_dns:
    - https://dns.cloudflare.com/dns-query
    - 1.1.1.1
  rewrites:
    - domain: "*.internal"
      answer: {{ caddy_container_ip }}
firstRunDone: true
http_proxy: ""
