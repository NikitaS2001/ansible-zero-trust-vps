networks:
  vpn_net:
    driver: bridge
{% if (wg_enable_ipv6 | default(false) | bool) %}
    enable_ipv6: true
{% endif %}
    ipam:
      config:
        - subnet: "{{ docker_network_subnet }}"
{% if (wg_enable_ipv6 | default(false) | bool) %}
        - subnet: "fd00:67:0:0::/64"
{% endif %}

services:
  wg-easy:
    image: ghcr.io/wg-easy/wg-easy:{{ wg_easy_version }}
    container_name: wg-easy
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv4.conf.all.src_valid_mark=1
{% if (wg_enable_ipv6 | default(false) | bool) %}
      - net.ipv6.conf.all.forwarding=1
{% else %}
      - net.ipv6.conf.all.disable_ipv6=1
{% endif %}
    environment:
      # INSECURE=true serves the wg-easy UI over HTTP on 127.0.0.1. It is
      # reachable only via an SSH tunnel or through Caddy TLS over the VPN,
      # and the panel itself is password-protected by the INIT_* setup.
      - INSECURE=true
{% if (wg_enable_ipv6 | default(false) | bool) %}
      # IPv6 mode: wg-easy allocates IPv6 subnets for clients and NATs their
      # traffic; requires a host with global IPv6 connectivity.
      - DISABLE_IPV6=false
{% else %}
      - DISABLE_IPV6=true
{% endif %}
{% if (not wg_easy_initialized | default(false) | bool) and (wg_easy_admin_password | length > 0) %}
      # First-start only: wg-easy consumes the INIT_* variables during its
      # initial setup and ignores them afterwards. They are rendered only until
      # the WireGuard config exists so the panel password is not persisted here.
      - INIT_ENABLED=true
      - INIT_USERNAME={{ wg_easy_admin_user }}
      - INIT_PASSWORD={{ wg_easy_admin_password }}
      - INIT_HOST={{ wg_public_host }}
      - INIT_PORT={{ wg_port }}
      - INIT_DNS={{ wg_client_dns }}
      - INIT_ALLOWED_IPS={% if (wg_enable_ipv6 | default(false) | bool) %}{{ (wg_allowed_ips + ['::/0']) | join(',') }}{% else %}{{ wg_allowed_ips | join(',') }}{% endif %}
{% endif %}
    volumes:
      - "{{ project_root }}/volumes/wg-easy:/etc/wireguard"
      - "/lib/modules:/lib/modules:ro"
    ports:
      - "{{ wg_port }}:{{ wg_container_port }}/udp"
      - "127.0.0.1:{{ wg_easy_bootstrap_ui_port }}:51821/tcp"
    networks:
      vpn_net:
        ipv4_address: "{{ wg_easy_container_ip }}"

  adguard:
    image: adguard/adguardhome:{{ adguard_version }}
    container_name: adguard
    restart: unless-stopped
    networks:
      vpn_net:
        ipv4_address: "{{ adguard_container_ip }}"
    ports:
      - "127.0.0.1:{{ adguard_bootstrap_ui_port }}:3000/tcp"
    volumes:
      - "{{ project_root }}/volumes/adguard/work:/opt/adguardhome/work"
      - "{{ project_root }}/volumes/adguard/conf:/opt/adguardhome/conf"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:3000/control/status >/dev/null || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

  caddy:
    image: caddy:{{ caddy_version }}
    container_name: caddy
    restart: unless-stopped
    networks:
      vpn_net:
        ipv4_address: "{{ caddy_container_ip }}"
    volumes:
      - "{{ project_root }}/volumes/caddy/data:/data"
      - "{{ project_root }}/volumes/caddy/config:/config"
      - "{{ project_root }}/Caddyfile:/etc/caddy/Caddyfile:ro"
      - "{{ project_root }}/Caddyfile.d:/etc/caddy/Caddyfile.d:ro"
    healthcheck:
      # Caddy's local admin endpoint is enabled by default on 127.0.0.1:2019.
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:2019/config/ >/dev/null || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
